{
  "name": "relayforge-api",
  "version": "1.0.0",
  "private": true,
  "description": "Webhook delivery API with idempotency, signatures, and retries",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "dev:worker": "node --env-file=.env --import tsx --watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.9",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^5.2.3",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
